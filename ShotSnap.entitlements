<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime (подпись Developer ID): пункт «Удалить ShotSnap…» отправляет
         бандл в Корзину через osascript → Finder, для этого нужны Apple Events. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
